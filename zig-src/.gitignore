# 配置恢复快照（含 jwt_secret 与全部存储凭据）—— 永不入库
tools/cfg-restore*.json

# ---- 构建产物（不入库）----
# 每次 `zig build` 都会重写它，入库只产生无意义的二进制 diff。
# 现役 aarch64 二进制留档在 D:/workspace/server/armbian/bin/openlist/openlist。
/dist/

# ---- 抓包 / 探针二进制 / 调试日志（本地产物，不入库）----
dist/*.pcap
dist/keys*.log
dist/hello_probe
dist/https_probe*
dist/tls_probe
dist/*.baseline
dist/*.prev
dist/*.trimmed

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 从网盘/前端抓下来的一次性研究素材 ----
/umi.js
/web_main.js
/h5_*.js
/fix_test_block.py

# 仓库内可选的本地凭据（首选 ~/.olz_root_pwd，仓库外）
tools/.root_pwd

# pan115.zig P115-REG 单测的合成 fixture（tools/gen_115_fixture.py 生成）：
# 必须入库 —— 被 @embedFile，缺文件时新克隆的 zig build test 编译失败。
# 真机原文 115list_sample.json 含真实文件名，继续由上面的 *.json 规则挡在库外。
!src/drivers/115list_fixture.json
