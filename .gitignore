.idea/
.DS_Store
output/
/dist/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.db
*.bin

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
/bin/*
*.json
!renovate.json
/build
/data/
/tmp/
/log/
/lang/
/daemon/
/public/dist/*
!/public/dist/README.md
/zig-src/.zig-cache/
# 本机构建产物（2026-10-22 起本机有 zig 工具链，`zig build` 会在这里落产物）
/zig-src/zig-out/

.VSCodeCounter
*.syso

# ---- 本地临时产物（不入库）----
# 旧记忆目录 .workbuddy/ 已于 2026-10-20 并入 .workbuddy-ai/memory/；
# 保留本行只为防止旧版本 agent 再把目录生出来。
/.workbuddy/
# 记忆目录里只放 markdown。历史上误存过 5 个 aarch64 构建产物（5.6MB），
# 2026-10-20 已清理；构建产物一律走 zig-src/dist/ 或归档目录。
/.workbuddy-ai/memory/*-aarch64
# 本地凭据保管（2026-10-22：WoPan 轮换令牌等，绝不入库）
/zig-src/tools/creds.local.json
